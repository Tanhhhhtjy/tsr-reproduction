# Copy to config.env and fill in. Everything else is fixed by the scripts.

# --- required ------------------------------------------------------------
# Hugging Face token with access to meta-llama/Llama-3.1-8B (gated model).
HF_TOKEN=
# API key for the AlpacaEval judge (OpenAI by default; see JUDGE_BASE_URL).
JUDGE_API_KEY=
# GPUs to use, comma-separated. Generation/judging are sharded over all of them;
# training keeps the global batch at 32. Tested: 2 x A800 80GB.
GPUS=0,1

# --- optional ------------------------------------------------------------
# Where models, generations, judgements and evaluation outputs are written (~200 GB for the full run).
WORK_DIR=./work
# Judge endpoint and model. For OpenRouter use
#   JUDGE_BASE_URL=https://openrouter.ai/api/v1  and  JUDGE_MODEL=openai/gpt-4o-2024-08-06
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-2024-08-06
# Base model: HF repo id or a local directory.
BASE_MODEL=meta-llama/Llama-3.1-8B
# Hugging Face mirror, if needed (e.g. https://hf-mirror.com).
HF_ENDPOINT=
# Python used to create .venv (3.11 is what we ran).
PYTHON=python3.11
